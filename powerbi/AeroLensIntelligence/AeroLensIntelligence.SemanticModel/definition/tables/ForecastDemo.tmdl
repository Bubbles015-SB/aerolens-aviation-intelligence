table ForecastDemo

	measure 'Synthetic Monthly Passengers' = SUM('ForecastDemo'[modelled_passengers])
		formatString: #,##0

	measure 'Synthetic Time Points' = COUNTROWS('ForecastDemo')
		formatString: #,##0

	column month
		dataType: string
		summarizeBy: none
		sourceColumn: month

	column modelled_passengers
		dataType: int64
		summarizeBy: none
		sourceColumn: modelled_passengers

	column period
		dataType: string
		summarizeBy: none
		sourceColumn: period

	column classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	partition ForecastDemo = m
		mode: import
		source =
			let
			    Source = #table(type table [month = type text, modelled_passengers = Int64.Type, period = type text, classification = type text], {
