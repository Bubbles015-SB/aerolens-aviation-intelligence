table EvidenceRegister

	measure 'Synthetic Documents' = COUNTROWS('EvidenceRegister')
		formatString: #,##0

	measure 'Review Ready Documents' = CALCULATE(COUNTROWS('EvidenceRegister'), 'EvidenceRegister'[status] = "ready")
		formatString: #,##0

	measure 'Blocked Documents' = CALCULATE(COUNTROWS('EvidenceRegister'), 'EvidenceRegister'[status] = "blocked")
		formatString: #,##0

	measure 'Readiness %' = DIVIDE([Review Ready Documents],[Synthetic Documents])
		formatString: 0.0%

	measure 'Critical Blocked' = CALCULATE(COUNTROWS('EvidenceRegister'), 'EvidenceRegister'[status] = "blocked", 'EvidenceRegister'[criticality] = "critical")
		formatString: #,##0

	column id
		dataType: string
		summarizeBy: none
		sourceColumn: id

	column requirement
		dataType: string
		summarizeBy: none
		sourceColumn: requirement

	column criticality
		dataType: string
		summarizeBy: none
		sourceColumn: criticality

	column revision
		dataType: int64
		summarizeBy: none
		sourceColumn: revision

	column approved_revision
		dataType: int64
		summarizeBy: none
		sourceColumn: approved_revision

	column approved
		dataType: boolean
		summarizeBy: none
		sourceColumn: approved

	column due_date
		dataType: string
		summarizeBy: none
		sourceColumn: due_date

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column issues
		dataType: string
		summarizeBy: none
		sourceColumn: issues

	column classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	partition EvidenceRegister = m
		mode: import
		source =
			let
			    Source = #table(type table [id = type text, requirement = type text, criticality = type text, revision = Int64.Type, approved_revision = Int64.Type, approved = type logical, due_date = type text, status = type text, issues = type text, classification = type text], {
