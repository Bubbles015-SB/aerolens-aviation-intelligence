table MarketObservations

	measure 'Selected Passenger Movements' = SUM('MarketObservations'[passengers])
		formatString: #,##0

	measure '2025 Market Movements' = CALCULATE(SUM('MarketObservations'[passengers]), 'MarketObservations'[year] = 2025)
		formatString: #,##0

	measure '2024 Market Movements' = CALCULATE(SUM('MarketObservations'[passengers]), 'MarketObservations'[year] = 2024)
		formatString: #,##0

	measure 'Market YoY Change' = [2025 Market Movements] - [2024 Market Movements]
		formatString: #,##0

	measure 'Market YoY Growth %' = DIVIDE([Market YoY Change],[2024 Market Movements])
		formatString: 0.0%

	measure 'Airport Markets' = DISTINCTCOUNT('MarketObservations'[code])
		formatString: #,##0

	measure 'Data Boundary Notice' = "CAA: selected airport pairs, all airlines, both directions; no route-level profitability"

	column code
		dataType: string
		summarizeBy: none
		sourceColumn: code

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column passengers
		dataType: int64
		summarizeBy: none
		sourceColumn: passengers

	column classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	partition MarketObservations = m
		mode: import
		source =
			let
