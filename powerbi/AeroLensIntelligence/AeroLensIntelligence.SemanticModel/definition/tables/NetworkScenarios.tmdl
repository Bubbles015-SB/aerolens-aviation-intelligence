table NetworkScenarios

	measure 'Synthetic Flight Legs' = COUNTROWS('NetworkScenarios')
		formatString: #,##0

	measure 'Synthetic Average Segment Minutes' = AVERAGE('NetworkScenarios'[duration_minutes])
		formatString: #,##0

	measure 'Fictional Operators' = DISTINCTCOUNT('NetworkScenarios'[carrier])
		formatString: #,##0

	column flight_id
		dataType: string
		summarizeBy: none
		sourceColumn: flight_id

	column carrier
		dataType: string
		summarizeBy: none
		sourceColumn: carrier

	column origin
		dataType: string
		summarizeBy: none
		sourceColumn: origin

	column destination
		dataType: string
		summarizeBy: none
		sourceColumn: destination

	column departure_utc
		dataType: string
		summarizeBy: none
		sourceColumn: departure_utc

	column arrival_utc
		dataType: string
		summarizeBy: none
		sourceColumn: arrival_utc

	column duration_minutes
		dataType: int64
		summarizeBy: none
		sourceColumn: duration_minutes

	column classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	partition NetworkScenarios = m
		mode: import
		source =
			let
