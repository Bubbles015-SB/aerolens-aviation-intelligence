table EmissionsScenarios

	measure 'Scenario Weekly CO2 Tonnes' = SUM('EmissionsScenarios'[model_co2_t])
		formatString: #,##0.0

	measure 'Scenario Weekly Fuel Tonnes' = SUM('EmissionsScenarios'[model_fuel_t])
		formatString: #,##0.0

	measure 'Scenario Weekly Departures' = SUM('EmissionsScenarios'[hypothetical_departures_per_week])
		formatString: #,##0

	column code
		dataType: string
		summarizeBy: none
		sourceColumn: code

	column city
		dataType: string
		summarizeBy: none
		sourceColumn: city

	column hypothetical_departures_per_week
		dataType: int64
		summarizeBy: none
		sourceColumn: hypothetical_departures_per_week

	column great_circle_km
		dataType: double
		summarizeBy: none
		sourceColumn: great_circle_km

	column assumed_block_hours_per_flight
		dataType: int64
		summarizeBy: none
		sourceColumn: assumed_block_hours_per_flight

	column model_fuel_t
		dataType: double
		summarizeBy: none
		sourceColumn: model_fuel_t

	column model_co2_t
		dataType: double
		summarizeBy: none
		sourceColumn: model_co2_t

	column model_kg_co2_per_pax_km
		dataType: double
		summarizeBy: none
		sourceColumn: model_kg_co2_per_pax_km

	column classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	partition EmissionsScenarios = m
		mode: import
		source =
			let
			    Source = #table(type table [code = type text, city = type text, hypothetical_departures_per_week = Int64.Type, great_circle_km = type number, assumed_block_hours_per_flight = Int64.Type, model_fuel_t = type number, model_co2_t = type number, model_kg_co2_per_pax_km = type number, classification = type text], {
			            {"JFK", "New York JFK", 8, 5540.0, 8, 352.0, 1112.32, 0.1144, "SYNTHETIC_EMISSIONS"},
			            {"LAX", "Los Angeles", 8, 8760.2, 12, 528.0, 1668.48, 0.1085, "SYNTHETIC_EMISSIONS"},
			            {"BOS", "Boston", 8, 5240.4, 7, 308.0, 973.28, 0.1058, "SYNTHETIC_EMISSIONS"},
			            {"MIA", "Miami", 8, 7109.3, 10, 440.0, 1390.4, 0.1115, "SYNTHETIC_EMISSIONS"},
			            {"ATL", "Atlanta", 8, 6761.0, 9, 396.0, 1251.36, 0.1055, "SYNTHETIC_EMISSIONS"},
			            {"SEA", "Seattle", 8, 7702.4, 11, 484.0, 1529.44, 0.1132, "SYNTHETIC_EMISSIONS"},
			            {"MCO", "Orlando", 8, 6965.7, 10, 440.0, 1390.4, 0.1137, "SYNTHETIC_EMISSIONS"},
			            {"DTW", "Detroit", 8, 6044.9, 8, 352.0, 1112.32, 0.1049, "SYNTHETIC_EMISSIONS"},
			            {"RDU", "Raleigh", 8, 6216.5, 9, 396.0, 1251.36, 0.1147, "SYNTHETIC_EMISSIONS"}
			    })
			in
			    Source
